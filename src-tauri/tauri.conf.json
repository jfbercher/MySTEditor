{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "myst-editor",
  "version": "0.1.0",
  "identifier": "jfb",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "myst-editor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,  
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "myst", "markdown", "txt"],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
	"macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
